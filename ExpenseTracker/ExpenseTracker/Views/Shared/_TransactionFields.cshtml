@model TransactionInput
@{
    var income = (string?)ViewData["TransactionKind"] == "Income";
    var categories = income ? TransactionInput.IncomeCategories : TransactionInput.ExpenseCategories;
    var originalCategory = ViewData["OriginalCategory"] as string;
}
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="field-grid">
    <div class="field">
        <label asp-for="Amount">Amount <span class="field-unit">@ViewBag.CurrencySymbol</span></label>
        <input asp-for="Amount" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" placeholder="0.00" />
        <span asp-validation-for="Amount" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Date"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="field-error"></span>
    </div>
    <div class="field field-wide">
        <label asp-for="Category"></label>
        <select asp-for="Category" class="form-select">
            <option value="">Choose a category</option>
            @if (!string.IsNullOrEmpty(originalCategory) && !categories.Contains(originalCategory))
            {
                <option value="@originalCategory">@originalCategory</option>
            }
            @foreach (var category in categories) { <option value="@category">@category</option> }
        </select>
        <span asp-validation-for="Category" class="field-error"></span>
    </div>
    <div class="field field-wide">
        <label asp-for="Description">Description <span class="field-unit">Optional</span></label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>
    @if (!income)
    {
        <div class="check-field field-wide">
            <input asp-for="IsFixed" class="form-check-input" aria-describedby="fixed-help" />
            <div><label asp-for="IsFixed"></label><p id="fixed-help">Show this payment in your fixed-expense list.</p></div>
        </div>
    }
</div>
