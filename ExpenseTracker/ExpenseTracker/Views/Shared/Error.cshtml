@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="surface status-page">
    <span class="empty-icon"><partial name="_Icon" model="@("info")" /></span>
    <h1>Something went wrong</h1>
    <p>Return to the overview and try again.</p>
    @if (Model.ShowRequestId) { <p class="request-id">Request ID <code>@Model.RequestId</code></p> }
    <a class="button button-primary" asp-controller="Home" asp-action="Index">Go to overview</a>
</section>
