@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var title = ViewData["Title"]?.ToString() ?? "Hishaber Khata";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f3" />
    <title>@title | Hishaber Khata</title>
    <link rel="icon" href="~/khata.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(signedIn ? "app-body" : "public-body")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    @if (signedIn)
    {
        <aside class="app-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><partial name="_Icon" model="@("brand")" /></span>
                <span><strong>Hishaber Khata</strong><small lang="bn">হিসাবের খাতা</small></span>
            </a>
            <partial name="_Navigation" />
            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="nav-entry" type="submit"><partial name="_Icon" model="@("logout")" /> Log out</button>
                </form>
            </div>
        </aside>
        <header class="app-header">
            <div class="header-inner">
                <span class="header-title"><span class="mobile-mark"><partial name="_Icon" model="@("brand")" /></span>@title</span>
                @if (!(controller == "Expense" && action == "AddExpense"))
                {
                    <details class="quick-add">
                        <summary class="button button-primary"><partial name="_Icon" model="@("plus")" /> Add transaction</summary>
                        <div class="popup-menu">
                            <a asp-controller="Expense" asp-action="AddExpense"><partial name="_Icon" model="@("expense")" /> Add expense</a>
                            <a asp-controller="Income" asp-action="Index" asp-fragment="add-income"><partial name="_Icon" model="@("income")" /> Add income</a>
                        </div>
                    </details>
                }
            </div>
        </header>
        <nav class="mobile-nav" aria-label="Quick navigation">
            <a asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" ? "page" : null)"><partial name="_Icon" model="@("overview")" /> Overview</a>
            <a asp-controller="MonthlyOverview" asp-action="Index" aria-current="@(controller == "MonthlyOverview" ? "page" : null)"><partial name="_Icon" model="@("ledger")" /> Transactions</a>
            <a asp-controller="Income" asp-action="Index" aria-current="@(controller == "Income" ? "page" : null)"><partial name="_Icon" model="@("income")" /> Income</a>
            <details class="mobile-more">
                <summary><partial name="_Icon" model="@("more")" /> More</summary>
                <div class="popup-menu">
                    <a asp-controller="Expense" asp-action="FixedExpense">Fixed expenses</a>
                    <a asp-controller="Settings" asp-action="Index">Settings</a>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Log out</button></form>
                </div>
            </details>
        </nav>
    }
    else
    {
        <header class="public-header">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><partial name="_Icon" model="@("brand")" /></span>
                <span><strong>Hishaber Khata</strong><small lang="bn">হিসাবের খাতা</small></span>
            </a>
        </header>
    }
    <main id="main-content" class="@(signedIn ? "app-main" : "public-main")" tabindex="-1">
        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="notice notice-success" role="status"><partial name="_Icon" model="@("check")" /> <span>@success</span></div>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="notice notice-error" role="alert"><partial name="_Icon" model="@("info")" /> <span>@error</span></div>
        }
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
