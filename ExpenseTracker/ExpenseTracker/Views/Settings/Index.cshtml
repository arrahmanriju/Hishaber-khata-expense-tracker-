@model SettingsInput
@{
    ViewData["Title"] = "Settings";
    var symbol = (string)ViewBag.CurrencySymbol;
    var budget = (decimal)ViewBag.SavedBudget;
    var spent = (decimal)ViewBag.MonthlyExpense;
    var remaining = (decimal)ViewBag.BudgetRemaining;
    var percentage = (decimal)ViewBag.BudgetPercentage;
}
<div class="page-intro"><div><h1>Settings</h1><p>Manage your profile, currency and monthly budget.</p></div></div>
<div class="insights-grid">
    <form class="surface form-panel" asp-action="UpdateSettings" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <fieldset class="settings-section">
            <legend>Profile</legend>
            <div class="field-grid">
                <div class="field"><label asp-for="UserName">Display name</label><input asp-for="UserName" class="form-control" autocomplete="name" /><span asp-validation-for="UserName" class="field-error"></span></div>
                <div class="field"><label asp-for="Email">Profile email <span class="field-unit">Optional</span></label><input asp-for="Email" type="email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div>
            </div>
        </fieldset>
        <fieldset class="settings-section">
            <legend>Money preferences</legend>
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Currency">Display currency</label>
                    <select asp-for="Currency" class="form-select" aria-describedby="currency-note">
                        <option value="BDT">BDT &middot; Bangladeshi taka</option><option value="USD">USD &middot; US dollar</option><option value="EUR">EUR &middot; Euro</option><option value="GBP">GBP &middot; British pound</option><option value="INR">INR &middot; Indian rupee</option>
                    </select>
                    <small id="currency-note">Changes the display symbol only.</small><span asp-validation-for="Currency" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="MonthlyBudget">Monthly budget <span class="field-unit">@symbol</span></label>
                    <input asp-for="MonthlyBudget" type="number" step="0.01" min="0" inputmode="decimal" class="form-control" aria-describedby="budget-note" />
                    <small id="budget-note">Set to zero to turn off the budget.</small><span asp-validation-for="MonthlyBudget" class="field-error"></span>
                </div>
            </div>
        </fieldset>
        <div class="form-actions"><button class="button button-primary" type="submit">Save settings</button></div>
    </form>
    <section class="surface budget" aria-labelledby="budget-title">
        <header class="section-head"><div><h2 id="budget-title">This month’s budget</h2><p>Based on recorded expenses</p></div></header>
        @if (budget > 0)
        {
            <div class="budget-detail">
                <strong class="money @(remaining < 0 ? "negative" : "")">@symbol @remaining.ToString("N2")</strong><p>Remaining</p>
                <meter min="0" max="100" value="@Math.Clamp(percentage, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Budget used"></meter>
                <dl><div><dt>Spent</dt><dd>@symbol @spent.ToString("N2")</dd></div><div><dt>Budget</dt><dd>@symbol @budget.ToString("N2")</dd></div></dl>
                <p>@percentage.ToString("N0")% used</p>
            </div>
        }
        else
        {
            <p class="inline-empty">Set a monthly budget to see how much you have left to spend.</p>
        }
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
