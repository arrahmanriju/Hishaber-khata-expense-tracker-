@model RegisterInput
@{ ViewData["Title"] = "Create your account"; }
<section class="auth-flow" aria-labelledby="auth-heading">
    <header><h1 id="auth-heading">Create your account</h1><p>Start your own ledger for income and expenses.</p></header>
    <div class="surface auth-surface">
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username" /><span asp-validation-for="Email" class="field-error"></span></div>
            <div class="field"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="field-error"></span></div>
            <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
            <button class="button button-primary" type="submit">Create account</button>
        </form>
    </div>
    <p class="auth-switch">Already have an account? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
