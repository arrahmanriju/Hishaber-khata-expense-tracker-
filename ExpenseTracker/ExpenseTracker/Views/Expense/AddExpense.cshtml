@model TransactionInput
@{ ViewData["Title"] = "Add expense"; }
<div class="page-intro"><div><h1>Add expense</h1><p>Record a payment and put it in the right category.</p></div></div>
<section class="surface form-panel narrow">
    <form asp-action="AddExpense" method="post">
        <partial name="_TransactionFields" model="Model" />
        <div class="form-actions">
            <button class="button button-primary" type="submit">Save expense</button>
            <a class="button button-secondary" asp-controller="Home" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
