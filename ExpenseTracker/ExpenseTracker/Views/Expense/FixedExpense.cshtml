@model IEnumerable<Transaction>
@{
    ViewData["Title"] = "Fixed expenses";
    ViewData["LedgerMode"] = "fixed";
    ViewData["LedgerTitle"] = "Fixed expense entries";
    ViewData["BreakdownTitle"] = "Fixed expenses by category";
    ViewData["BreakdownUsesTotal"] = true;
    ViewData["BreakdownShowsCount"] = true;
    var month = (int)ViewBag.SelectedMonth;
    var year = (int)ViewBag.SelectedYear;
    var groups = (IEnumerable<dynamic>)ViewBag.ExpenseByCategory;
}
<div class="page-intro">
    <div><h1>Fixed expenses</h1><p>Review the payments you marked as fixed.</p></div>
    <partial name="_Period" model="(month, year)" />
</div>
<dl class="summary-strip surface"><div><dt>Total fixed expenses</dt><dd class="money negative">@ViewBag.CurrencySymbol @(((decimal)ViewBag.TotalFixedExpense).ToString("N2"))</dd></div></dl>
<partial name="_Ledger" model="Model" />
<partial name="_Breakdown" model="groups" />
