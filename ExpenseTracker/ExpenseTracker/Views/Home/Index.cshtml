@{
    ViewData["Title"] = "Overview";
    var month = (int)ViewBag.SelectedMonth;
    var year = (int)ViewBag.SelectedYear;
    var income = (decimal)ViewBag.TotalIncome;
    var expense = (decimal)ViewBag.TotalExpense;
    var balance = (decimal)ViewBag.Balance;
    var symbol = (string)ViewBag.CurrencySymbol;
    var currency = (string)ViewBag.Currency;
    var recent = (IEnumerable<Transaction>)ViewBag.RecentTransactions;
    ViewData["LedgerMode"] = "recent";
    ViewData["LedgerTitle"] = "Recent transactions";
    ViewData["BreakdownTitle"] = "Spending by category";
}
<div class="page-intro">
    <div><h1>Overview</h1><p>Here’s where your money went this month.</p></div>
    <partial name="_Period" model="(month, year)" />
</div>
<section class="balance-panel" aria-label="Monthly balance">
    <div class="balance-main">
        <div class="balance-label"><span>Monthly balance</span><span class="balance-currency">@currency</span></div>
        <strong class="balance-value money @(balance < 0 ? "balance-deficit" : "")">@(balance < 0 ? "−" : "")@symbol @Math.Abs(balance).ToString("N2")</strong>
        <p>Income minus expenses for @(new DateTime(year, month, 1).ToString("MMMM")).</p>
    </div>
    <dl class="balance-details">
        <div><dt><partial name="_Icon" model="@("income")" /> Income</dt><dd class="money">@symbol @income.ToString("N2")</dd></div>
        <div><dt><partial name="_Icon" model="@("expense")" /> Expenses</dt><dd class="money">@symbol @expense.ToString("N2")</dd></div>
        @if (income > 0)
        {
            <div><dt>Net savings rate</dt><dd class="money">@((balance / income).ToString("P0"))</dd></div>
        }
    </dl>
</section>
<div class="insights-grid">
    <section class="surface trend" aria-labelledby="trend-title">
        <header class="section-head">
            <div><h2 id="trend-title">Spending trend</h2><p>Monthly expenses over six months</p></div>
            <span class="chart-key"><i aria-hidden="true"></i> Expenses</span>
        </header>
        <div class="chart-slot" id="spending-chart" hidden><canvas id="expense-trend" role="img" aria-label="Monthly spending over six months"></canvas></div>
        <p class="inline-empty" id="trend-empty" hidden>No expenses recorded in this period.</p>
        <details class="trend-data" id="trend-data" hidden>
            <summary>View monthly values</summary>
            <dl id="trend-values"></dl>
        </details>
        <noscript><p class="inline-empty">Enable JavaScript to see the spending trend.</p></noscript>
    </section>
    <partial name="_Breakdown" model="@((IEnumerable<dynamic>)ViewBag.ExpenseByCategory)" />
</div>
<partial name="_Ledger" model="recent" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const monthlyData = @Json.Serialize((object)ViewBag.MonthlyData);
        window.khataSpendingTrend(monthlyData, @Json.Serialize(symbol), @Json.Serialize(currency));
    </script>
}
