@{
    ViewData["Title"] = "Transactions";
    var month = (int)ViewBag.SelectedMonth;
    var year = (int)ViewBag.SelectedYear;
    var symbol = (string)ViewBag.CurrencySymbol;
    var transactions = (IEnumerable<Transaction>)ViewBag.Transactions;
    var incomeGroups = (IEnumerable<dynamic>)ViewBag.IncomeByCategory;
    var expenseGroups = (IEnumerable<dynamic>)ViewBag.ExpenseByCategory;
    var balance = (decimal)ViewBag.Balance;
    ViewData["BreakdownShowsCount"] = true;
    ViewData["PeriodJump"] = true;
    ViewData["LedgerTitle"] = "Monthly ledger";
}
<div class="page-intro">
    <div><h1>Transactions</h1><p>Find and review income and expenses by month.</p></div>
    <a class="button button-secondary" asp-action="ExportToExcel" asp-route-month="@month" asp-route-year="@year"><partial name="_Icon" model="@("download")" /> Export Excel</a>
</div>
<div class="period-toolbar">
    <partial name="_Period" model="(month, year)" />
</div>
<dl class="summary-strip surface">
    <div><dt>Income</dt><dd class="money positive">@symbol @(((decimal)ViewBag.TotalIncome).ToString("N2"))</dd></div>
    <div><dt>Expenses</dt><dd class="money negative">@symbol @(((decimal)ViewBag.TotalExpense).ToString("N2"))</dd></div>
    <div><dt>Net balance</dt><dd class="money @(balance < 0 ? "negative" : "")">@(balance < 0 ? "−" : "")@symbol @Math.Abs(balance).ToString("N2")</dd></div>
</dl>
<partial name="_Ledger" model="transactions" />
<div class="equal-grid">
    <partial name="_Breakdown" model="incomeGroups" view-data='new ViewDataDictionary(ViewData) { ["BreakdownTitle"] = "Income by category" }' />
    <partial name="_Breakdown" model="expenseGroups" view-data='new ViewDataDictionary(ViewData) { ["BreakdownTitle"] = "Expenses by category" }' />
</div>
