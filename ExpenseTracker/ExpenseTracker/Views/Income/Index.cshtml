@model TransactionInput
@{
    ViewData["Title"] = "Income";
    ViewData["TransactionKind"] = "Income";
    ViewData["LedgerMode"] = "income";
    ViewData["LedgerTitle"] = "Income entries";
    ViewData["BreakdownTitle"] = "Income by category";
    ViewData["BreakdownUsesTotal"] = true;
    ViewData["BreakdownShowsCount"] = true;
    var month = (int)ViewBag.SelectedMonth;
    var year = (int)ViewBag.SelectedYear;
    var incomes = (IEnumerable<Transaction>)ViewBag.Incomes;
    var groups = (IEnumerable<dynamic>)ViewBag.IncomeByCategory;
}
<div class="page-intro">
    <div><h1>Income</h1><p>Record what came in and see your income sources.</p></div>
    <partial name="_Period" model="(month, year)" />
</div>
<div class="equal-grid">
    <section class="surface form-panel" id="add-income" aria-labelledby="income-title">
        <header class="section-head"><div><h2 id="income-title">Add income</h2></div></header>
        <form asp-action="AddIncome" asp-route-month="@month" asp-route-year="@year" method="post">
            <partial name="_TransactionFields" model="Model" />
            <div class="form-actions"><button class="button button-primary" type="submit">Save income</button></div>
        </form>
    </section>
    <div class="stack">
        <dl class="summary-strip surface"><div><dt>Total income</dt><dd class="money positive">@ViewBag.CurrencySymbol @(((decimal)ViewBag.TotalIncome).ToString("N2"))</dd></div></dl>
        <partial name="_Breakdown" model="groups" />
    </div>
</div>
<partial name="_Ledger" model="incomes" />
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
